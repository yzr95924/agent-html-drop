# Generated by `agent-html-drop nginx-config`. Paste into your existing nginx.
#
# This is a *pure reverse-proxy snippet* (design §15.3.3): the daemon serves
# everything itself — including /files/* — so nginx does NOT read the docroot,
# and TLS termination is your nginx's job (no ssl directives below).
#
# daemon port:     {{PORT}}
# public_base_url: {{PUBLIC_BASE_URL}}   (informational)
#
# Placement:
#   - `limit_req_zone` goes in the `http {}` context (outside any server).
#   - The `location` blocks go in your HTTPS server block for this domain
#     (the one that already terminates TLS for it).

# Rate-limit /api/auth and annotation write routes to deter brute-force token
# guessing. Belongs in the http context, outside server.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/s;

# MCP Streamable HTTP — disable buffering so streams flow, long timeout for
# long-lived tool calls.
location /mcp {
    proxy_pass http://127.0.0.1:{{PORT}}/mcp;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_read_timeout 86400;
}

# Annotation auth + write routes — rate-limited (token is 256-bit random,
# this just slows scripted guessing).
location = /api/auth {
    limit_req zone=auth burst=20 nodelay;
    proxy_pass http://127.0.0.1:{{PORT}};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location ~ ^/api/files/[^/]+/annotations {
    limit_req zone=auth burst=20 nodelay;
    proxy_pass http://127.0.0.1:{{PORT}};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

# Everything else — management page /, JSON API /api/*, public files /files/*
# — is served by the daemon. /files/* included: the daemon streams the HTML
# itself; nginx never reads the docroot.
location / {
    proxy_pass http://127.0.0.1:{{PORT}};
    proxy_set_header Host $host;
}
